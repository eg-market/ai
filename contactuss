<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>اتصل بنا</title>
<style>
body {
font-family: Arial, sans-serif;
margin: 0;
padding: 20px;
display: flex;
justify-content: center;
align-items: center;
min-height: 100vh;
background: linear-gradient(180deg, #0b5fa5, #083e73);
direction: rtl;
}

.contact-form {
background: white;
padding: 30px;
border-radius: 10px;
box-shadow: 0 0 20px rgba(0,0,0,0.1);
width: 100%;
max-width: 500px;
}

h1 {
color: #0b5fa5;
text-align: center;
margin-bottom: 30px;
}

.form-group {
margin-bottom: 20px;
}

label {
display: block;
margin-bottom: 5px;
color: #333;
}

input, textarea {
width: 100%;
padding: 10px;
border: 1px solid #ddd;
border-radius: 5px;
font-size: 16px;
direction: rtl;
}

textarea {
height: 150px;
resize: vertical;
}

button {
background: #0b5fa5;
color: white;
padding: 12px 25px;
border: none;
border-radius: 5px;
cursor: pointer;
width: 100%;
font-size: 16px;
}

button:hover {
background: #083e73;
}

.success-message {
color: green;
text-align: center;
display: none;
}

.error-message {
color: red;
text-align: center;
display: none;
}
</style>
</head>
<body>
<div class="contact-form">
<h1>اتصل بنا</h1>
<div class="form-group">
<label for="name">الاسم:</label>
<input type="text" id="name" required>
</div>
<div class="form-group">
<label for="email">البريد الإلكتروني:</label>
<input type="email" id="email" required>
</div>
<div class="form-group">
<label for="message">الرسالة:</label>
<textarea id="message" required></textarea>
</div>
<button onclick="sendEmail()">إرسال</button>
<p id="successMessage" class="success-message">تم إرسال رسالتك بنجاح!</p>
<p id="errorMessage" class="error-message">حدث خطأ. يرجى المحاولة مرة أخرى.</p>
</div>

<script src="https://cdn.jsdelivr.net/npm/@emailjs/browser@3/dist/email.min.js"></script>
<script>
emailjs.init("LgUkZLzt8N_NS-Bo6"); // Replace with your actual public key

function sendEmail() {
// Get form values
const name = document.getElementById('name').value;
const email = document.getElementById('email').value;
const message = document.getElementById('message').value;

// Validate form
if (!name || !email || !message) {
document.getElementById('errorMessage').style.display = 'block';
document.getElementById('successMessage').style.display = 'none';
return;
}

// Prepare template parameters
const templateParams = {
from_name: name,
from_email: email,
to_email: 'wlid11@yahoo.com',
message: message
};

// Send email
emailjs.send('YOUR_SERVICE_ID', 'YOUR_TEMPLATE_ID', templateParams)
.then(function(response) {
// Success
document.getElementById('successMessage').style.display = 'block';
document.getElementById('errorMessage').style.display = 'none';
// Clear form
document.getElementById('name').value = '';
document.getElementById('email').value = '';
document.getElementById('message').value = '';
}, function(error) {
// Error
document.getElementById('errorMessage').style.display = 'block';
document.getElementById('successMessage').style.display = 'none';
});
}
</script>
</body>
</html>
